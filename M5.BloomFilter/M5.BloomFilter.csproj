<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Authors>MILL5</Authors>
    <Company>MILL5</Company>
    <Copyright>Copyright © MILL5, LLC 2021-2026</Copyright>
    <Description>A Bloom filter for .NET 10. Lock-free lookups, allocation-free string, numeric and span keys, sizing from an expected count and a false-positive target, occupancy estimates, union of compatible filters, immutable snapshots, and a versioned persisted format with JSON and protobuf companion packages.</Description>
    <PackageProjectUrl>https://mill5.github.io/M5.BloomFilter/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/MILL5/M5.BloomFilter</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageIcon>bitarray_400-min.png</PackageIcon>
	<IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
	<PackageTags>bloom;filter;bloomfilter;bloom-filter;probabilistic;membership;set;hash;murmur3;cache;dictionary;map</PackageTags>
	<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
	<GenerateDocumentationFile>true</GenerateDocumentationFile>
	<NoWarn>$(NoWarn);CS1591</NoWarn>
	<Version>2.1.0</Version>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Optimize>false</Optimize>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Pineapple" Version="1.0.41" />
  </ItemGroup>

	<ItemGroup>
		<None Include="bitarray_400-min.png">
			<Pack>True</Pack>
			<PackagePath></PackagePath>
		</None>
	</ItemGroup>

</Project>
