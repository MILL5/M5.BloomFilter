<Project Sdk="Microsoft.NET.Sdk">

  <!-- Not part of the solution and never packed. See docs/benchmarks.md.
       Set the environment variable Baseline=true to measure the published
       2.0.1 package with the same source. It is an environment variable, not
       -p:Baseline, so the project BenchmarkDotNet generates sees it too. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <DefineConstants Condition="'$(Baseline)' == 'true'">$(DefineConstants);BASELINE</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(Baseline)' == 'true'">
    <PackageReference Include="M5.BloomFilter" Version="[2.0.1]" />
  </ItemGroup>

  <ItemGroup Condition="'$(Baseline)' != 'true'">
    <ProjectReference Include="..\..\M5.BloomFilter\M5.BloomFilter.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.16.0-preview.2" />
  </ItemGroup>

</Project>
