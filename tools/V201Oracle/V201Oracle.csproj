<Project Sdk="Microsoft.NET.Sdk">

  <!-- Generates compatibility fixtures from the published 2.0.1 packages.
       Not part of the solution and never packed. See README.md. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="M5.BloomFilter" Version="[2.0.1]" />
    <PackageReference Include="M5.BloomFilter.Serialization.Json" Version="[2.0.1]" />
    <PackageReference Include="M5.BloomFilter.Serialization.ProtoBuf" Version="[2.0.1]" />
  </ItemGroup>

</Project>
