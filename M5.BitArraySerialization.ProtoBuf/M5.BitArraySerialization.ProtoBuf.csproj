<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Description>Serialization helpers for BitArray in .NET using Google Protocol Buffers</Description>
    <Authors>MILL5</Authors>
    <Version>2.2.0</Version>
    <PackageProjectUrl>https://github.com/MILL5/M5.BloomFilter</PackageProjectUrl>
    <RepositoryUrl>https://github.com/MILL5/M5.BloomFilter</RepositoryUrl>
    <PackageIcon>bitarray_400-min.png</PackageIcon>
    <PackageIconUrl />
    <RepositoryType>git</RepositoryType>
    <PackageTags>serialization;bit;array;google;protobuf;protocol;buffers</PackageTags>
    <Copyright>Copyright © MILL5, LLC 2021-2026</Copyright>
	<IncludeSymbols>true</IncludeSymbols>
	<SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Pineapple" Version="2.0.0" />
    <PackageReference Include="protobuf-net" Version="3.4.40" />
  </ItemGroup>

  <ItemGroup>
    <None Include="bitarray_400-min.png">
		<Pack>True</Pack>
		<PackagePath></PackagePath>
	</None>
  </ItemGroup>	
	
  <Import Project="..\M5.BitArraySerialization.Shared\M5.BitArraySerialization.Shared.projitems" Label="Shared" />

</Project>
